<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Welcome to Mexmy.lk</title>
</head>
<body style="margin:0; padding:0; background-color:#f4f6f9; font-family:'Segoe UI', Arial, sans-serif;">

<table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f6f9; padding:40px 0;">
    <tr>
        <td align="center">

            <!-- Card -->
            <table width="600" cellpadding="0" cellspacing="0" style="background-color:#ffffff; border-radius:12px; overflow:hidden; box-shadow:0 4px 20px rgba(0,0,0,0.08);">

                <!-- Header -->
                <tr>
                    <td style="background:linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%); padding:40px 48px; text-align:center;">
                        <h1 style="margin:0; color:#e94560; font-size:32px; font-weight:800; letter-spacing:2px;">
                            Mexmy<span style="color:#ffffff;">.lk</span>
                        </h1>
                        <p style="margin:8px 0 0; color:#a0aec0; font-size:13px; letter-spacing:3px; text-transform:uppercase;">
                            Your trusted platform
                        </p>
                    </td>
                </tr>

                <!-- Hero -->
                <tr>
                    <td style="background:linear-gradient(135deg, #e94560 0%, #c73652 100%); padding:32px 48px; text-align:center;">
                        <p style="margin:0; font-size:13px; color:#ffe0e6; letter-spacing:2px; text-transform:uppercase; font-weight:600;">
                            Welcome aboard 🎉
                        </p>
                        <h2 style="margin:10px 0 0; color:#ffffff; font-size:26px; font-weight:700;">
                            Hello, <%= firstName %> <%= lastName %>!
                        </h2>
                    </td>
                </tr>

                <!-- Body -->
                <tr>
                    <td style="padding:48px 48px 32px;">

                        <p style="margin:0 0 20px; color:#4a5568; font-size:16px; line-height:1.8;">
                            We're thrilled to have you join <strong style="color:#1a1a2e;">Mexmy.lk</strong>.
                            Your account has been created successfully and you're all set to explore everything we have to offer.
                        </p>

                        <p style="margin:0 0 32px; color:#4a5568; font-size:16px; line-height:1.8;">
                            To get started, please verify your email address using the button below.
                            This link will expire in <strong style="color:#e94560;">24 hours</strong>.
                        </p>

                        <!-- CTA -->
                        <table width="100%" cellpadding="0" cellspacing="0">
                            <tr>
                                <td align="center" style="padding:8px 0 40px;">
                                    <a href="<%= token %>"
                                       style="display:inline-block; background:linear-gradient(135deg, #e94560 0%, #c73652 100%); color:#ffffff; text-decoration:none; font-size:16px; font-weight:700; padding:16px 48px; border-radius:50px; letter-spacing:1px; box-shadow:0 4px 15px rgba(233,69,96,0.4);">
                                        ✉&nbsp; Verify My Email
                                    </a>
                                </td>
                            </tr>
                        </table>

                        <hr style="border:none; border-top:1px solid #e2e8f0; margin:0 0 32px;" />

                        <!-- Info Cards -->
                        <table width="100%" cellpadding="0" cellspacing="0">
                            <tr>
                                <td width="30%" style="background:#f8fafc; border-radius:10px; padding:20px; text-align:center; vertical-align:top;">
                                    <p style="margin:0; font-size:28px;">🛍️</p>
                                    <p style="margin:8px 0 4px; color:#1a1a2e; font-size:14px; font-weight:700;">Shop</p>
                                    <p style="margin:0; color:#718096; font-size:12px; line-height:1.6;">Browse thousands of products</p>
                                </td>
                                <td width="5%"></td>
                                <td width="30%" style="background:#f8fafc; border-radius:10px; padding:20px; text-align:center; vertical-align:top;">
                                    <p style="margin:0; font-size:28px;">🔒</p>
                                    <p style="margin:8px 0 4px; color:#1a1a2e; font-size:14px; font-weight:700;">Secure</p>
                                    <p style="margin:0; color:#718096; font-size:12px; line-height:1.6;">Safe & encrypted payments</p>
                                </td>
                                <td width="5%"></td>
                                <td width="30%" style="background:#f8fafc; border-radius:10px; padding:20px; text-align:center; vertical-align:top;">
                                    <p style="margin:0; font-size:28px;">🚚</p>
                                    <p style="margin:8px 0 4px; color:#1a1a2e; font-size:14px; font-weight:700;">Deliver</p>
                                    <p style="margin:0; color:#718096; font-size:12px; line-height:1.6;">Fast delivery island-wide</p>
                                </td>
                            </tr>
                        </table>

                        <hr style="border:none; border-top:1px solid #e2e8f0; margin:32px 0;" />

                        <!-- Token fallback -->
                        <p style="margin:0 0 8px; color:#718096; font-size:13px; line-height:1.6;">
                            If the button doesn't work, copy and paste the link below into your browser:
                        </p>
                        <p style="margin:0; background:#f8fafc; border:1px solid #e2e8f0; border-radius:6px; padding:12px 16px; font-size:12px; color:#e94560; word-break:break-all;">
                            <%= token %>
                        </p>

                    </td>
                </tr>

                <!-- Footer -->
                <tr>
                    <td style="background:#1a1a2e; padding:32px 48px; text-align:center;">
                        <p style="margin:0 0 8px; color:#e94560; font-size:18px; font-weight:800; letter-spacing:1px;">
                            Mexmy<span style="color:#ffffff;">.lk</span>
                        </p>
                        <p style="margin:0 0 16px; color:#718096; font-size:12px; line-height:1.6;">
                            Sri Lanka's trusted online marketplace
                        </p>
                        <p style="margin:0; color:#4a5568; font-size:11px; line-height:1.8;">
                            You received this email because you signed up at Mexmy.lk.<br/>
                            If this wasn't you, please ignore this email.
                        </p>
                        <p style="margin:16px 0 0; color:#4a5568; font-size:11px;">
                            &copy; <%= new Date().getFullYear() %> Mexmy.lk. All rights reserved.
                        </p>
                    </td>
                </tr>

            </table>
        </td>
    </tr>
</table>

</body>
</html>